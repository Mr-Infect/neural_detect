ND_ENVIRONMENT=development
ND_DATABASE_URL=postgresql+asyncpg://neural:neural@postgres:5432/neural_detect
ND_ELASTICSEARCH_URL=http://elasticsearch:9200
ND_ELASTICSEARCH_API_KEY=
ND_ELASTICSEARCH_USERNAME=elastic
ND_ELASTICSEARCH_PASSWORD=generate-with-openssl-rand-hex-32
# Elasticsearch/Kibana security. setup.sh replaces these placeholders; sign in to Kibana as elastic.
ND_ELASTIC_PASSWORD=generate-with-openssl-rand-hex-32
ND_KIBANA_SYSTEM_PASSWORD=generate-with-openssl-rand-hex-32
ND_ELASTICSEARCH_VERIFY_CERTS=false
ND_ELASTICSEARCH_INDEX_PATTERN=neural-detect-*
ND_KIBANA_URL=http://kibana:5601
# Kibana needs a 32+ character key to create detection rules. setup.sh replaces this placeholder.
ND_KIBANA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
ND_SECRET_KEY=replace-with-a-random-secret-before-deployment
ND_BOOTSTRAP_ADMIN_EMAIL=admin@neural-detect.local
ND_BOOTSTRAP_ADMIN_PASSWORD=generate-a-random-32-byte-secret
ND_OPA_URL=http://opa:8181
ND_SOAR_WEBHOOK_URL=
ND_SOAR_WEBHOOK_TOKEN=
POSTGRES_USER=neural
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=neural_detect

# Required to review deployment approvals; use a secret manager in hosted environments.
ND_DETECTION_APPROVAL_TOKEN=

# Hybrid AI model gateway; hosted inference is disabled unless explicitly enabled.
ND_AI_DEFAULT_PROVIDER=ollama
ND_AI_CLOUD_ENABLED=false
ND_AI_TIMEOUT_SECONDS=30
ND_AI_RETRIES=1
ND_OLLAMA_URL=http://host.docker.internal:11435
ND_OLLAMA_MODEL=llama3.2:3b
ND_LLAMA_CPP_URL=http://llama-cpp:8080/v1
ND_LLAMA_CPP_MODEL=local-model
ND_LLAMA_CPP_API_KEY=
ND_OPENAI_BASE_URL=https://api.openai.com/v1
ND_OPENAI_MODEL=gpt-4o-mini
ND_OPENAI_API_KEY=
ND_ANTHROPIC_BASE_URL=https://api.anthropic.com
ND_ANTHROPIC_MODEL=claude-3-5-haiku-latest
ND_ANTHROPIC_API_KEY=
ND_AI_TENANT_POLICIES_JSON={}
ND_AI_OPENAI_COMPATIBLE_INPUT_USD_PER_MILLION=
ND_AI_OPENAI_COMPATIBLE_OUTPUT_USD_PER_MILLION=
ND_AI_ANTHROPIC_INPUT_USD_PER_MILLION=
ND_AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=

ND_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
